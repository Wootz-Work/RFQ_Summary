# --------
# LLM (Claude)
# --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Fallbacks must be peers of the primary — a retry on a much weaker model returns a
# quietly worse answer, which is harder to catch than a failure.
ANTHROPIC_MODEL_FALLBACKS=claude-opus-4-8,claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_ADAPTIVE_THINKING=true
# Extra identical attempts when a call comes back with no text at all, before
# trying a different configuration (thinking off) or the next fallback model.
# An empty reply is not always reproducible: thinking depth varies call to
# call, and a refusal on borderline content is not guaranteed to repeat. Each
# retry costs a full call again (100-200+ seconds on a large extraction) —
# raise PRODUCT_EXTRACTION_TIMEOUT_SEC / JOB_TIMEOUT_SEC alongside this if you
# increase it. 0 disables retries and preserves the old behaviour.
ANTHROPIC_EMPTY_REPLY_RETRIES=1
# How deep adaptive thinking goes: low | medium | high | xhigh | max. Empty =
# API default. Thinking and the answer share one token budget on Opus 5 / Opus
# 4.8 / Sonnet 5 (budget_tokens, which used to give thinking its own separate
# cap, is removed on these models) — effort is the closest substitute: lower
# it if thinking keeps crowding the answer out of the budget.
ANTHROPIC_EFFORT=
# Same lever, scoped to the product-extraction call only — the one call that
# has actually shown this failure on a large input. Leave empty to just follow
# ANTHROPIC_EFFORT above; set this instead of the global if triage/costing/
# classification should stay at full effort while only product extraction backs off.
PRODUCT_EXTRACTION_EFFORT=

# --------
# Web Search (Perplexity)
# --------
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Model examples: sonar, sonar-pro (depends on your plan)
PERPLEXITY_MODEL=sonar
PERPLEXITY_MAX_RESULTS=5

# --------
# Task behavior
# --------
MAX_ATTACHMENT_BYTES=52428800
MAX_PDF_PAGES=60
# Zip archives — a customer drawing package is routinely a zip of folders, so
# members are unpacked in memory and each one is parsed exactly as it would be
# if it had been sent on its own. A zip is untrusted input and a small one can
# expand without limit, so all three of these are hard stops: hitting one ends
# the walk and is reported in the attachment summary rather than raising.
ZIP_MAX_MEMBERS=200
ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
# 1 = read a zip; 2 = also read a zip nested inside it. Deeper than that is
# almost always an accident or an attack, never a drawing package.
ZIP_MAX_DEPTH=2
OUTPUT_DIR=./out
OUTPUT_MODE=local
LOG_LEVEL=INFO
GOOGLE_DRIVE_SA_JSON_B64=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=

# --------
# Incoming query triage / ALL RFQ writeback
# --------
ENABLE_TRIAGE_WRITEBACK=true
PROMPT_QUERY_TRIAGE_FILE=prompts/query_triage.md
