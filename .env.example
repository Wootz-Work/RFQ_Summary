# --------
# LLM (Claude)
# --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Fallbacks must be peers of the primary — a retry on a much weaker model returns a
# quietly worse answer, which is harder to catch than a failure.
ANTHROPIC_MODEL_FALLBACKS=claude-opus-4-8,claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_ADAPTIVE_THINKING=true

# --------
# Web Search (Perplexity)
# --------
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Model examples: sonar, sonar-pro (depends on your plan)
PERPLEXITY_MODEL=sonar
PERPLEXITY_MAX_RESULTS=5

# --------
# Task behavior
# --------
MAX_ATTACHMENT_BYTES=52428800
MAX_PDF_PAGES=60
OUTPUT_DIR=./out
OUTPUT_MODE=local
LOG_LEVEL=INFO
GOOGLE_DRIVE_SA_JSON_B64=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=

# --------
# Incoming query triage / ALL RFQ writeback
# --------
ENABLE_TRIAGE_WRITEBACK=true
PROMPT_QUERY_TRIAGE_FILE=prompts/query_triage.md
PROMPT_QUERY_COSTING_FILE=prompts/query_costing_estimate.md
PROMPT_QUERY_RFQ_CLASSIFICATION_FILE=prompts/query_rfq_classification.md
GLIDE_API_KEY=
GLIDE_APP_ID=ARzoymvBNIgO6RcvRk7l
GLIDE_ALL_RFQ_TABLE=native-table-24696dcc-caaf-4bf8-a015-1e9ef394aa1b
GLIDE_COL_ALL_RFQ_ZAI_RESPONSE=MANCF
GLIDE_COL_ALL_RFQ_COSTING_ORDER_OF_MAGNITUDE=AEa95
GLIDE_PROSPECT_RFQ_TABLE=native-table-498cd72b-6e47-4820-b737-f167d509b1ec
GLIDE_COL_PROSPECT_GEOGRAPHY=sMkF2
GLIDE_COL_PROSPECT_INDUSTRY=QOtPb
GLIDE_COL_PROSPECT_CLIENT_NAME=ikKdb
GLIDE_COL_PROSPECT_STANDARDS=fmNSP
GLIDE_COL_PROSPECT_TITLE=Fg2uK
GLIDE_COL_PROSPECT_SEQUENCE=qxQ9p
GLIDE_ALL_COMPANIES_TABLE=native-table-g1GlBSdbNmRtTx16ecxD
GLIDE_COL_ALL_COMPANIES_PET_NAME=Name
GLIDE_COL_ALL_COMPANIES_ORIGINAL_NAME=MdnWu
GLIDE_ZAI_REGENERATE_TABLE=native-table-7bc7712b-e6aa-4b72-a673-e8d8e233bdfc
GLIDE_COL_ZAI_REGENERATE_RFQ_ID=Name
GLIDE_COL_ZAI_REGENERATE_RESPONSE=lpklF
GLIDE_COL_ZAI_REGENERATE_RESPONSE_GENERATED_TIME=MWSLA
GLIDE_COL_ZAI_REGENERATE_REQUESTED_TIME=rkoqR
GLIDE_COL_ZAI_REGENERATE_INSTRUCTION=QRAYI
GLIDE_COL_ZAI_REGENERATE_REQUESTED_BY=sErZm
GLIDE_COL_ZAI_REGENERATE_QUERY=plNaX
GLIDE_COL_ZAI_REGENERATE_TYPE=s1843
GLIDE_COL_ZAI_REGENERATE_VERSION=KaglL

# --------
# ALL Product writeback (product line items extracted from the incoming query)
# --------
# false = complete no-op: no third LLM call, /query/triage unchanged.
ENABLE_PRODUCT_EXTRACTION=true
# false = extraction still runs, but no rows are written to Glide.
ENABLE_PRODUCT_WRITEBACK=true
PRODUCT_EXTRACTION_MAX_TOKENS=16000
PROMPT_PRODUCT_EXTRACTION_FILE=prompts/rfq_product_extraction.md
# The ALL Product table and its column ids are baked into config.py as defaults,
# so nothing below needs to be set. Uncomment only to point at a different table
# (e.g. a scratch copy) or to leave a column alone by setting it empty.
#GLIDE_ALL_PRODUCT_TABLE=native-table-4c42a6c4-6b7c-476f-88a8-65c0e8d3c774
#GLIDE_COL_PRODUCT_NAME=Name
#GLIDE_COL_PRODUCT_QTY=KAbSp
#GLIDE_COL_PRODUCT_DETAILS=K03pz
#GLIDE_COL_PRODUCT_RFQ_ID=3E2xY
#GLIDE_COL_PRODUCT_TARGET_PRICE=hgVgd
#GLIDE_COL_PRODUCT_DWG_LINK=f4QCb
#GLIDE_COL_PRODUCT_REP_URL=LXcW2
#GLIDE_COL_PRODUCT_ADDL_FILES=JR0Lx
#GLIDE_COL_PRODUCT_SR_NO=XbErc
#GLIDE_COL_PRODUCT_ACCEPTED=117zS
#GLIDE_COL_PRODUCT_INTERNAL_NOTES=vizbU

# Queries table — one row per open question, linked to the product it blocks.
# Query ID is database-assigned and Query Response is the customer's; neither is written.
ENABLE_QUERY_WRITEBACK=true
#GLIDE_QUERIES_TABLE=native-table-19b47480-d912-462e-8721-584b5063f704
#GLIDE_COL_QUERY_RFQ_ID=Name
#GLIDE_COL_QUERY_PRODUCT_ID=pfIJe
#GLIDE_COL_QUERY_DESCRIPTION=Ucd5N
# Query Photo is off — the model cannot reliably pick the attachment that shows
# an ambiguity. Set it to KbO6i to start writing that column.
GLIDE_COL_QUERY_PHOTO=
GLIDE_PRODUCT_ROWS_PER_REQUEST=20
PRODUCT_EXTRACTION_TIMEOUT_SEC=300
